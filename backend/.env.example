APP_NAME="SOTO Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=soto_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@soto.test"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb WebSocket
REVERB_APP_ID=soto_reverb
REVERB_APP_KEY=change-me-reverb-key
REVERB_APP_SECRET=change-me-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# MQTT / HiveMQ
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=nodered
MQTT_PASSWORD=change-me

# Internal API (shared secret between Node-RED and Laravel)
INTERNAL_API_SECRET=change-me-in-production

# SOTO Business Config
SOTO_POINTS_PER_BOTTLE=10
SOTO_DEFAULT_THRESHOLD=80

VITE_APP_NAME="${APP_NAME}"
